    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(106,141,82,0.13),transparent_32%),radial-gradient(circle_at_80%_10%,rgba(169,104,69,0.14),transparent_22%),linear-gradient(180deg,rgba(49,91,91,0.06),transparent_55%)]"></div>
