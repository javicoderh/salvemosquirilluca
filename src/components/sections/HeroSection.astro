<script>
  import { getSignatureCount, invalidateSignatureCountCache } from "../../lib/signatures";

  const mobileValueNode = document.querySelector("[data-mobile-counter-value]");
  const mobileChileNode = document.querySelector("[data-mobile-counter-chile]");
  const mobileForeignNode = document.querySelector("[data-mobile-counter-foreign]");
  const fmt = (n: number) => new Intl.NumberFormat("es-CL").format(n);

  const refreshMobile = async () => {
    if (!(mobileValueNode instanceof HTMLElement)) return;
    try {
      const c = await getSignatureCount();
      mobileValueNode.textContent = fmt(c.count);
      if (mobileChileNode instanceof HTMLElement) mobileChileNode.textContent = fmt(c.chileanCount);
      if (mobileForeignNode instanceof HTMLElement) mobileForeignNode.textContent = fmt(c.foreignCount);
    } catch { /* keep displayed value */ }
  };

  refreshMobile();
  window.addEventListener("signature:created", () => { invalidateSignatureCountCache(); refreshMobile(); });
  window.setInterval(() => { invalidateSignatureCountCache(); refreshMobile(); }, 1000 * 60 * 10);
</script>

<script>
  const heroVideo = document.querySelector("[data-hero-video]");
  const playButton = document.querySelector("[data-hero-video-play]");

  if (heroVideo instanceof HTMLVideoElement) {
    const fallbackToMuted = async () => {
      heroVideo.muted = true;
      try {
        await heroVideo.play();
      } catch (error) {
        console.error(error);
      }
    };

    const playWithSoundOnce = async () => {
      heroVideo.pause();
      heroVideo.currentTime = 0;
      heroVideo.muted = false;

      try {
        await heroVideo.play();
      } catch (error) {
        console.error(error);
        await fallbackToMuted();
      }
    };

    heroVideo.addEventListener("ended", () => {
      heroVideo.muted = true;
    });

    if (playButton instanceof HTMLButtonElement) {
      playButton.addEventListener("click", () => {
        playWithSoundOnce();
      });
    }

    playWithSoundOnce();
  }
</script>
