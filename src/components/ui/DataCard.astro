---
interface Props {
  value?: string;
  label: string;
  detail: string;
}

const { label, detail } = Astro.props;
---

<article class="surface-panel rounded-3xl p-6">
  <h3 class="text-xl font-semibold leading-tight text-white">{label}</h3>
  <p class="mt-3 text-sm leading-6 text-campaign-text-muted">{detail}</p>
</article>
