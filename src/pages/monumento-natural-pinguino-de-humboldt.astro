---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
const breadcrumbItems = [{ name: "Inicio", path: "/" }, { name: "Protección", path: "/monumento-natural-pinguino-de-humboldt" }];
---
<MainLayout path="/monumento-natural-pinguino-de-humboldt" title="Protección de Quirilluca | Salvemos Quirilluca" description="Conoce las herramientas de protección territorial que pueden resguardar los valores de Quirilluca." keywords={["protección Quirilluca", "Santuario de la Naturaleza", "Sitio Prioritario", "conservación"]} breadcrumbItems={breadcrumbItems} pageType="AboutPage">
  <Section size="compact"><Breadcrumbs items={breadcrumbItems} /><SectionHeading eyebrow="Protección" title="Cuidar Quirilluca requiere una figura y una voluntad pública" body="Quirilluca reúne valores naturales y culturales que deben ser reconocidos en la planificación territorial y en las decisiones ambientales." as="h1" /></Section>
  <Section class="pt-0"><div class="grid gap-4 md:grid-cols-3"><article class="surface-panel rounded-[1.75rem] p-6"><h2 class="text-xl font-bold text-white">Sitio Prioritario</h2><p class="mt-4 text-sm leading-7 text-campaign-text-muted">Reconoce la importancia ecológica del territorio y orienta su consideración en políticas de conservación.</p></article><article class="surface-panel rounded-[1.75rem] p-6"><h2 class="text-xl font-bold text-white">Santuario de la Naturaleza</h2><p class="mt-4 text-sm leading-7 text-campaign-text-muted">Es una figura de protección oficial que puede resguardar componentes naturales y culturales de relevancia.</p></article><article class="surface-panel rounded-[1.75rem] p-6"><h2 class="text-xl font-bold text-white">Planificación local</h2><p class="mt-4 text-sm leading-7 text-campaign-text-muted">Las decisiones comunales y regionales deben considerar paisaje, biodiversidad, riesgos y vida comunitaria.</p></article></div></Section>
</MainLayout>
