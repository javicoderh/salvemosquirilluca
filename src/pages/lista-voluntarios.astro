---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import { isPostgresAvailable } from "../lib/db/postgres";
import { isSecurityConfigured, isServerStorageConfigured } from "../lib/security/config";
import { getVolunteerPortalSessionFromCookies } from "../lib/security/volunteer-portal-auth";
import { listVolunteerSubmissions } from "../lib/security/volunteer-storage";

export const prerender = false;

Astro.response.headers.set("cache-control", "private, no-store, max-age=0");
Astro.response.headers.set("pragma", "no-cache");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow, noarchive");

const breadcrumbItems = [
  { name: "Inicio", path: "/" },
  { name: "Lista de voluntarios", path: "/lista-voluntarios" }
];
const session = await getVolunteerPortalSessionFromCookies(Astro.cookies);
const configured = isSecurityConfigured && isServerStorageConfigured && isPostgresAvailable;
const error = Astro.url.searchParams.get("error");
const search = (Astro.url.searchParams.get("buscar") ?? "").trim().slice(0, 120);
const rawStatus = Astro.url.searchParams.get("estado") ?? "all";
const status = rawStatus === "accepted" || rawStatus === "flagged" ? rawStatus : "all";
const requestedPage = Number(Astro.url.searchParams.get("pagina") ?? "1");
const page = Number.isFinite(requestedPage)
  ? Math.max(1, Math.floor(requestedPage))
  : 1;
const result =
  session && configured
    ? await listVolunteerSubmissions({ search, status, page, pageSize: 100 })
    : null;

const formatDateTime = (value: number) =>
  new Intl.DateTimeFormat("es-CL", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "America/Santiago"
  }).format(new Date(value));

const pageHref = (nextPage: number) => {
  const params = new URLSearchParams();
  if (search) params.set("buscar", search);
  if (status !== "all") params.set("estado", status);
  params.set("pagina", String(nextPage));
  return `/lista-voluntarios?${params.toString()}`;
};
---

<MainLayout
  path="/lista-voluntarios"
  title="Lista de voluntarios | Salvemos Quirilluca"
  description="Acceso privado a las inscripciones de voluntariado."
  hideFloatingCta={true}
  robots="noindex,nofollow,noarchive"
  breadcrumbItems={breadcrumbItems}
>
  <Section size="compact">
    <Breadcrumbs items={breadcrumbItems} />

    {!configured ? (
      <div class="mx-auto mt-8 max-w-xl surface-panel rounded-[2rem] p-8 md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-warm">Acceso privado</p>
        <h1 class="mt-3 text-3xl font-black text-white">Configuración incompleta</h1>
        <p class="mt-4 text-base leading-7 text-campaign-text-muted">
          La lista necesita una conexión PostgreSQL y la configuración de seguridad server-side.
        </p>
      </div>
    ) : !session ? (
      <section class="volunteer-login">
        <div class="volunteer-login__visual" aria-hidden="true">
          <img
            src="/assets/quirilluca/OTR-01_comunidad_manifestacion_salvemos_quirilluca.jpg"
            alt=""
          />
          <div></div>
          <span>ACCESO / VOLUNTARIADO</span>
        </div>

        <div class="volunteer-login__form surface-panel">
          <p>Área privada</p>
          <h1>Lista de voluntarios</h1>
          <span>
            Este espacio contiene datos personales y requiere una sesión autorizada.
          </span>

          {error && (
            <div class="volunteer-login__error" role="alert">
              {error === "rate_limited"
                ? "Se alcanzó el límite de intentos. Espera antes de volver a probar."
                : error === "config"
                  ? "El acceso seguro no está disponible en este momento."
                  : error === "invalid"
                    ? "La solicitud de acceso no es válida."
                    : error}
            </div>
          )}

          <form method="post" action="/api/volunteer-portal/login">
            <div class="hidden" aria-hidden="true">
              <label>
                Empresa
                <input name="company" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <label>
              <span>Contraseña</span>
              <input
                type="password"
                name="password"
                autocomplete="current-password"
                minlength="8"
                maxlength="128"
                required
                autofocus
              />
            </label>

            <button type="submit">Entrar a la lista</button>
          </form>
          <small>Sesión privada · duración máxima de 8 horas</small>
        </div>
      </section>
    ) : (
      <div class="volunteer-directory">
        <header class="volunteer-directory__header">
          <div>
            <p>Área privada / Salvemos Quirilluca</p>
            <h1>Lista de voluntarios</h1>
            <span>
              {result?.total ?? 0} {(result?.total ?? 0) === 1 ? "inscripción encontrada" : "inscripciones encontradas"}
            </span>
          </div>
          <form method="post" action="/api/volunteer-portal/logout">
            <button type="submit">Cerrar sesión</button>
          </form>
        </header>

        <form method="get" class="volunteer-directory__filters">
          <label>
            <span>Buscar</span>
            <input
              type="search"
              name="buscar"
              value={search}
              maxlength="120"
              placeholder="Nombre, correo o teléfono"
            />
          </label>
          <label>
            <span>Estado</span>
            <select name="estado">
              <option value="all" selected={status === "all"}>Todos</option>
              <option value="accepted" selected={status === "accepted"}>Registrados</option>
              <option value="flagged" selected={status === "flagged"}>En revisión</option>
            </select>
          </label>
          <button type="submit">Aplicar filtros</button>
          {(search || status !== "all") && <a href="/lista-voluntarios">Limpiar</a>}
        </form>

        <div class="volunteer-directory__notice">
          <span aria-hidden="true">●</span>
          Datos personales: utiliza esta información únicamente para coordinar el voluntariado de la campaña.
        </div>

        {result && result.items.length > 0 ? (
          <ol class="volunteer-list">
            {result.items.map((volunteer, index) => (
              <li>
                <article class="volunteer-card">
                  <div class="volunteer-card__index">
                    <span>{String((result.page - 1) * result.pageSize + index + 1).padStart(3, "0")}</span>
                    <i class:list={[volunteer.status === "flagged" && "is-review"]}></i>
                  </div>

                  <div class="volunteer-card__identity">
                    <small>{volunteer.status === "flagged" ? "En revisión" : "Registrado"}</small>
                    <h2>{volunteer.fullName}</h2>
                    <time datetime={new Date(volunteer.createdAtMs).toISOString()}>
                      {formatDateTime(volunteer.createdAtMs)}
                    </time>
                  </div>

                  <div class="volunteer-card__contact">
                    <span>Contacto</span>
                    <a href={`mailto:${volunteer.email}`}>{volunteer.email}</a>
                    <a href={`tel:${volunteer.phone}`}>{volunteer.phone}</a>
                  </div>

                  <div class="volunteer-card__reason">
                    <span>Motivación</span>
                    <p>{volunteer.reason}</p>
                  </div>

                  <div class="volunteer-card__consent">
                    <span>Consentimiento</span>
                    <strong>{volunteer.consent ? "Aceptado" : "Sin registro"}</strong>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        ) : (
          <div class="volunteer-directory__empty">
            <p>No hay inscripciones que coincidan con estos filtros.</p>
          </div>
        )}

        {result && result.totalPages > 1 && (
          <nav class="volunteer-pagination" aria-label="Páginas de voluntarios">
            {result.page > 1 ? <a href={pageHref(result.page - 1)}>← Anterior</a> : <span></span>}
            <strong>Página {result.page} de {result.totalPages}</strong>
            {result.page < result.totalPages ? <a href={pageHref(result.page + 1)}>Siguiente →</a> : <span></span>}
          </nav>
        )}
      </div>
    )}
  </Section>
</MainLayout>

<style>
  .volunteer-login {
    display: grid;
    max-width: 68rem;
    min-height: 34rem;
    margin: 1.5rem auto 0;
    overflow: hidden;
    border: 1px solid rgba(215, 192, 155, 0.17);
    border-radius: 2rem;
    background: #11130d;
  }

  .volunteer-login__visual {
    position: relative;
    min-height: 17rem;
    overflow: hidden;
  }

  .volunteer-login__visual img,
  .volunteer-login__visual div {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .volunteer-login__visual img {
    object-fit: cover;
    filter: grayscale(0.5) contrast(1.1);
  }

  .volunteer-login__visual div {
    background: linear-gradient(0deg, rgba(17, 19, 13, 0.88), transparent 65%);
  }

  .volunteer-login__visual > span {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    color: white;
    font-family: "Courier New", monospace;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .volunteer-login__form {
    display: flex;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 0;
    flex-direction: column;
    justify-content: center;
  }

  .volunteer-login__form > p,
  .volunteer-directory__header p {
    color: var(--campaign-warm);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .volunteer-login__form h1,
  .volunteer-directory__header h1 {
    margin-top: 0.55rem;
    color: white;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .volunteer-login__form > span {
    max-width: 32rem;
    margin-top: 0.9rem;
    color: var(--campaign-text-muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .volunteer-login__form form {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .volunteer-login__form label,
  .volunteer-directory__filters label {
    display: grid;
    gap: 0.45rem;
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .volunteer-login__form input,
  .volunteer-directory__filters input,
  .volunteer-directory__filters select {
    min-height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.055);
    padding: 0.75rem 1rem;
    color: white;
  }

  .volunteer-login__form button,
  .volunteer-directory__filters button {
    min-height: 3rem;
    border-radius: 999px;
    background: var(--campaign-sky);
    padding: 0.75rem 1.2rem;
    color: white;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-shadow: 0 1px 2px black;
    text-transform: uppercase;
  }

  .volunteer-login__form > small {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.46);
    font-size: 0.62rem;
  }

  .volunteer-login__error {
    margin-top: 1rem;
    border: 1px solid rgba(248, 113, 113, 0.35);
    border-radius: 1rem;
    background: rgba(127, 29, 29, 0.22);
    padding: 0.8rem 1rem;
    color: #fecaca;
    font-size: 0.75rem;
  }

  .volunteer-directory {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .volunteer-directory__header {
    display: flex;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    align-items: end;
    justify-content: space-between;
    border: 1px solid rgba(215, 192, 155, 0.17);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 100% 0, rgba(106, 141, 82, 0.22), transparent 42%),
      #151a12;
  }

  .volunteer-directory__header h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .volunteer-directory__header span {
    display: block;
    margin-top: 0.7rem;
    color: var(--campaign-text-muted);
    font-size: 0.76rem;
  }

  .volunteer-directory__header button,
  .volunteer-directory__filters a {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.7rem 1rem;
    color: white;
    font-size: 0.68rem;
    font-weight: 800;
    text-decoration: none;
  }

  .volunteer-directory__filters {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    align-items: end;
    border: 1px solid rgba(215, 192, 155, 0.14);
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.025);
  }

  .volunteer-directory__filters a {
    display: grid;
    min-height: 3rem;
    place-items: center;
  }

  .volunteer-directory__notice {
    display: flex;
    gap: 0.65rem;
    padding: 0.8rem 1rem;
    align-items: center;
    border: 1px solid rgba(208, 164, 87, 0.2);
    border-radius: 1rem;
    background: rgba(208, 164, 87, 0.07);
    color: var(--campaign-text-muted);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .volunteer-directory__notice span {
    color: var(--campaign-warm);
  }

  .volunteer-list {
    display: grid;
    gap: 0.65rem;
    list-style: none;
  }

  .volunteer-card {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid rgba(215, 192, 155, 0.14);
    border-radius: 1.5rem;
    background: #151a12;
  }

  .volunteer-card__index {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--campaign-warm);
    font-family: "Courier New", monospace;
    font-size: 0.65rem;
    font-weight: 800;
  }

  .volunteer-card__index i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--campaign-sky);
  }

  .volunteer-card__index i.is-review {
    background: var(--campaign-warm);
  }

  .volunteer-card small,
  .volunteer-card__contact > span,
  .volunteer-card__reason > span,
  .volunteer-card__consent > span {
    color: var(--campaign-sky);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .volunteer-card h2 {
    margin-top: 0.25rem;
    color: white;
    font-size: 1.2rem;
  }

  .volunteer-card time {
    display: block;
    margin-top: 0.25rem;
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.62rem;
  }

  .volunteer-card__contact,
  .volunteer-card__reason,
  .volunteer-card__consent {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .volunteer-card__contact a {
    overflow-wrap: anywhere;
    color: white;
    font-size: 0.72rem;
    text-decoration-color: rgba(208, 164, 87, 0.5);
    text-underline-offset: 0.2rem;
  }

  .volunteer-card__reason p {
    color: var(--campaign-text-muted);
    font-size: 0.74rem;
    line-height: 1.55;
    white-space: pre-wrap;
  }

  .volunteer-card__consent strong {
    color: white;
    font-size: 0.72rem;
  }

  .volunteer-directory__empty {
    display: grid;
    min-height: 13rem;
    place-items: center;
    border: 1px dashed rgba(215, 192, 155, 0.18);
    border-radius: 1.5rem;
    color: var(--campaign-text-muted);
    text-align: center;
  }

  .volunteer-pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    color: var(--campaign-text-muted);
    font-size: 0.7rem;
  }

  .volunteer-pagination a {
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .volunteer-pagination a:last-child {
    text-align: right;
  }

  @media (min-width: 720px) {
    .volunteer-login {
      grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
    }

    .volunteer-login__visual {
      min-height: 34rem;
    }

    .volunteer-directory__filters {
      grid-template-columns: minmax(16rem, 1fr) minmax(10rem, 0.35fr) auto auto;
    }
  }

  @media (min-width: 960px) {
    .volunteer-card {
      grid-template-columns: 3rem minmax(12rem, 0.8fr) minmax(13rem, 0.85fr) minmax(20rem, 1.45fr) 7rem;
      align-items: start;
    }
  }
</style>
