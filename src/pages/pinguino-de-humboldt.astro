---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";

const breadcrumbItems = [{ name: "Inicio", path: "/" }, { name: "Quirilluca", path: "/pinguino-de-humboldt" }];
const pillars = [
  ["Biodiversidad", "Acantilados, bosque esclerófilo, matorral costero y fauna nativa forman un mosaico conectado."],
  ["Geología y paisaje", "Las terrazas y acantilados cuentan una historia geológica única frente al océano Pacífico."],
  ["Comunidad y memoria", "Caleta Horcón y las comunidades de Puchuncaví sostienen una relación cotidiana con este territorio."],
  ["Patrimonio vivo", "Proteger Quirilluca es cuidar agua, suelo, biodiversidad, paisaje y formas locales de habitar."],
];
---
<MainLayout path="/pinguino-de-humboldt" title="Quirilluca | Un territorio vivo" description="Conoce los valores naturales, geológicos, culturales y comunitarios de los Acantilados de Quirilluca." keywords={["Quirilluca", "Acantilados de Quirilluca", "Horcón", "Puchuncaví", "patrimonio natural"]} breadcrumbItems={breadcrumbItems} pageType="AboutPage">
  <Section size="compact"><Breadcrumbs items={breadcrumbItems} /><SectionHeading eyebrow="El territorio" title="Quirilluca es mucho más que un paisaje" body="Los Acantilados de Quirilluca son un territorio vivo: un lugar de biodiversidad, memoria, trabajo comunitario y belleza costera que merece protección." as="h1" /></Section>
  <Section class="pt-0"><div class="grid gap-4 md:grid-cols-2">{pillars.map(([title, body]) => <article class="surface-panel rounded-[1.75rem] p-6"><h2 class="text-xl font-bold text-white">{title}</h2><p class="mt-4 text-base leading-7 text-campaign-text-muted">{body}</p></article>)}</div></Section>
  <Section class="pt-0"><div class="surface-panel rounded-[2rem] p-8"><h2 class="text-2xl font-bold text-white">Una defensa que comenzó en comunidad</h2><p class="mt-4 max-w-3xl text-base leading-7 text-campaign-text-muted">Desde 2017, vecinas, vecinos y organizaciones locales han documentado y defendido el valor de Quirilluca. Esta plataforma reúne información para que más personas conozcan el territorio y participen en su cuidado.</p></div></Section>
</MainLayout>
