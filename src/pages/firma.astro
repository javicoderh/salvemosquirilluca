---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import SignatureForm from "../components/ui/SignatureForm.astro";
import { campaignConfig } from "../content/campaign";

export const prerender = false;

const { dates, signatureForm } = campaignConfig;
---

<MainLayout
  path="/firma"
  title="Súmate a Salvemos Quirilluca"
  description="Registra tu apoyo informado para proteger los Acantilados de Quirilluca y su territorio vivo."
  hideFloatingCta={true}
  keywords={["Salvemos Quirilluca", "Acantilados de Quirilluca", "participación ciudadana", "protección territorial"]}
  breadcrumbItems={[{ name: "Inicio", path: "/" }, { name: "Firma", path: "/firma" }]}
>
  <Section size="hero">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="space-y-6">
        <div class="surface-panel rounded-[2rem] p-8 md:p-10">
          <SectionHeading
            eyebrow="Firma"
            title={signatureForm.title}
            body={`La meta de esta fase es reunir respaldo antes del ${dates.signatureDeadlineLabel}. ${signatureForm.intro}`}
            as="h1"
          />

          <div class="mt-8 grid gap-3">
            {signatureForm.trustPoints.map((item) => (
              <div class="rounded-2xl border border-white/12 bg-white/5 px-4 py-3 text-sm font-medium text-white">
                {item}
              </div>
            ))}
          </div>
        </div>

        <div class="surface-panel rounded-[2rem] p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-campaign-sky">Apoyo informado</p>
          <p class="mt-4 text-base leading-7 text-campaign-text-muted">
            Antes de sumarte, conoce el territorio, la amenaza y las fuentes que respaldan esta defensa comunitaria.
          </p>

          <div class="mt-6 flex flex-wrap gap-4">
            <ButtonLink href="/pinguino-de-humboldt" label="Conocer Quirilluca" variant="secondary" />
            <ButtonLink href="/transparencia" label="Ver transparencia" variant="ghost" />
          </div>
        </div>
      </div>

      <div id="formulario-firma">
        <div class="mb-4 flex gap-3">
          <button
            id="tab-chilean"
            class="focus-ring inline-flex min-h-10 items-center justify-center rounded-full border border-white/20 bg-white/10 px-5 py-2 text-sm font-bold uppercase tracking-[0.08em] text-white transition hover:bg-white/15"
            aria-pressed="true"
          >
            Firmar (Chile)
          </button>
        </div>

        <div id="form-chilean">
          <SignatureForm />
        </div>

      </div>
    </div>
  </Section>
</MainLayout>

<!-- The Chilean form remains the temporary fallback until the new database is connected. -->
