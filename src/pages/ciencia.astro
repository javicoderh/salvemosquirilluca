---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
const breadcrumbItems = [{ name: "Inicio", path: "/" }, { name: "Documentos", path: "/ciencia" }];
const sources = [
  ["Investigación Salvemos Quirilluca", "Contexto territorial, valores del sitio, historia comunitaria y amenazas actuales.", "/transparencia"],
  ["Archivo visual", "Imágenes de acantilados, flora, fauna, paisaje y movilización comunitaria.", "/"],
  ["Evaluación ambiental y fuentes públicas", "Consulta los antecedentes oficiales y verifica siempre la fecha de cada documento.", "https://www.sea.gob.cl/"]
];
---
<MainLayout path="/ciencia" title="Documentos y fuentes | Salvemos Quirilluca" description="Investigación, antecedentes públicos y fuentes para conocer y defender Quirilluca." keywords={["documentos Quirilluca", "investigación Quirilluca", "evaluación ambiental", "fuentes públicas"]} breadcrumbItems={breadcrumbItems} pageType="CollectionPage">
  <Section size="compact"><Breadcrumbs items={breadcrumbItems} /><SectionHeading eyebrow="Documentos" title="Fuentes para conocer el territorio" body="Reunimos antecedentes para conversar sobre Quirilluca con memoria local, evidencia y responsabilidad." as="h1" /></Section>
  <Section class="pt-0"><div class="grid gap-4 md:grid-cols-3">{sources.map(([title, body, href]) => <a href={href} class="surface-panel rounded-[1.75rem] p-6 transition hover:-translate-y-0.5"><h2 class="text-xl font-bold text-white">{title}</h2><p class="mt-4 text-sm leading-7 text-campaign-text-muted">{body}</p><span class="mt-5 inline-block text-sm font-semibold text-campaign-sky">Abrir fuente →</span></a>)}</div></Section>
</MainLayout>
