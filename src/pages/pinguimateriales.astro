---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
const breadcrumbItems = [{ name: "Inicio", path: "/" }, { name: "Materiales", path: "/pinguimateriales" }];
const materials = [
  ["Guía para conocer Quirilluca", "Una lectura breve sobre biodiversidad, paisaje, memoria y comunidad."],
  ["Kit de conversación comunitaria", "Preguntas y fuentes para conversar sobre la amenaza territorial con respeto y evidencia."],
  ["Archivo visual", "Imágenes para actividades educativas y difusión responsable del territorio."],
];
---
<MainLayout path="/pinguimateriales" title="Materiales educativos | Salvemos Quirilluca" description="Recursos para aprender, conversar y participar en la defensa de Quirilluca." keywords={["materiales Quirilluca", "educación ambiental", "Puchuncaví", "participación comunitaria"]} breadcrumbItems={breadcrumbItems}>
  <Section size="compact"><Breadcrumbs items={breadcrumbItems} /><SectionHeading eyebrow="Materiales" title="Aprender también es una forma de cuidar" body="Recursos para escuelas, familias, organizaciones y personas que quieren conocer Quirilluca." as="h1" /></Section>
  <Section class="pt-0"><div class="grid gap-4 md:grid-cols-3">{materials.map(([title, body]) => <article class="surface-panel rounded-[1.75rem] p-6"><h2 class="text-xl font-bold text-white">{title}</h2><p class="mt-4 text-sm leading-7 text-campaign-text-muted">{body}</p><a href="/ciencia" class="mt-5 inline-block text-sm font-semibold text-campaign-sky">Ver fuentes →</a></article>)}</div></Section>
</MainLayout>
