---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import ThreatDossier from "../components/campaign/ThreatDossier.vue";
const breadcrumbItems = [{ name: "Inicio", path: "/" }, { name: "La amenaza", path: "/amenazas" }];
---
<MainLayout path="/amenazas" title="La amenaza | Salvemos Quirilluca" description="Explora la escala territorial, los impactos ambientales y la batalla jurídica del proyecto Maratué en Quirilluca." keywords={["amenaza Quirilluca", "Maratué", "Puchuncaví", "defensa territorial"]} breadcrumbItems={breadcrumbItems} pageType="AboutPage">
  <Section size="compact">
    <Breadcrumbs items={breadcrumbItems} class="mb-1" />
    <ThreatDossier client:load />
  </Section>
</MainLayout>
