---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
const breadcrumbItems = [{ name: "Inicio", path: "/" }, { name: "La amenaza", path: "/amenazas" }];
const threats = [
  ["Proyecto Maratué", "El proyecto inmobiliario contempla 1.045 hectáreas y 14.180 viviendas en un entorno de alto valor ecológico y paisajístico."],
  ["Fragmentación del territorio", "La urbanización puede interrumpir corredores naturales, aumentar la presión sobre el suelo y alterar la relación entre acantilados, bosque y costa."],
  ["Pérdida de biodiversidad", "La remoción de vegetación y el tránsito asociado a nuevas obras amenazan hábitats, especies nativas y procesos ecológicos locales."],
  ["Presión sobre la vida comunitaria", "El cambio de escala territorial puede afectar accesos, paisaje, actividades tradicionales y la identidad de las comunidades cercanas."],
];
---
<MainLayout path="/amenazas" title="La amenaza | Salvemos Quirilluca" description="Conoce las presiones territoriales y ambientales que enfrenta Quirilluca." keywords={["amenaza Quirilluca", "Maratué", "Puchuncaví", "defensa territorial"]} breadcrumbItems={breadcrumbItems} pageType="AboutPage">
  <Section size="compact"><Breadcrumbs items={breadcrumbItems} /><SectionHeading eyebrow="La amenaza" title="Lo que está en juego" body="Quirilluca enfrenta una transformación territorial de gran escala. Entender sus impactos ayuda a participar en el debate público con información." as="h1" /></Section>
  <Section class="pt-0"><div class="grid gap-4 md:grid-cols-2">{threats.map(([title, body]) => <article class="surface-panel rounded-[1.75rem] p-6"><h2 class="text-xl font-bold text-white">{title}</h2><p class="mt-4 text-base leading-7 text-campaign-text-muted">{body}</p></article>)}</div></Section>
  <Section class="pt-0"><div class="surface-panel rounded-[2rem] p-8"><h2 class="text-2xl font-bold text-white">Información pública, decisiones responsables</h2><p class="mt-4 max-w-3xl text-base leading-7 text-campaign-text-muted">Las cifras y antecedentes deben leerse junto con la evaluación ambiental, las observaciones ciudadanas y el conocimiento local. Consulta los documentos y comparte información verificable.</p></div></Section>
</MainLayout>
