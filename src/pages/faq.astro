---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
const breadcrumbItems = [{ name: "Inicio", path: "/" }, { name: "Preguntas frecuentes", path: "/faq" }];
const faqs = [
  ["¿Qué es Quirilluca?", "Es un territorio costero de la comuna de Puchuncaví, especialmente vinculado a Caleta Horcón, reconocido por sus acantilados, biodiversidad, paisaje y memoria comunitaria."],
  ["¿Qué se busca proteger?", "El conjunto de valores naturales, geológicos, paleontológicos, paisajísticos, sociales y culturales que hacen de Quirilluca un territorio irreemplazable."],
  ["¿Cuál es la amenaza principal?", "La transformación inmobiliaria asociada al proyecto Maratué y sus impactos acumulativos sobre suelo, biodiversidad, paisaje, agua y vida comunitaria."],
  ["¿Cómo puedo participar?", "Puedes informarte, compartir fuentes, asistir a actividades comunitarias y registrar tu apoyo en el formulario de Súmate."],
  ["¿La información está respaldada?", "La sección Documentos reúne antecedentes públicos. Cuando una cifra o estado administrativo dependa de una fecha, debe revisarse en su fuente original."],
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([question, answer]) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) };
---
<MainLayout path="/faq" title="Preguntas frecuentes | Salvemos Quirilluca" description="Respuestas claras sobre Quirilluca, sus valores, amenazas y formas de participar." keywords={["preguntas Quirilluca", "Maratué", "participación ciudadana", "Puchuncaví"]} breadcrumbItems={breadcrumbItems} pageType="FAQPage" schema={faqSchema}>
  <Section size="compact"><Breadcrumbs items={breadcrumbItems} /><SectionHeading eyebrow="Preguntas frecuentes" title="Entender para participar" body="Respuestas breves para orientarte en la defensa de Quirilluca." as="h1" /></Section>
  <Section class="pt-0"><div class="grid gap-4">{faqs.map(([question, answer]) => <article class="surface-panel rounded-[1.75rem] p-6"><h2 class="text-xl font-bold text-white">{question}</h2><p class="mt-4 text-base leading-7 text-campaign-text-muted">{answer}</p></article>)}</div></Section>
</MainLayout>
